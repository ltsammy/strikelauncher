<Application x:Class="StrikeLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- "Cold Iron Protocol" - synthesized from an Imperial/Republic/Rimrunner design
                 panel for Age of Clones - Strike Platoon (104th Battalion): gunmetal/steel
                 near-black chrome, hard 2px "milled steel plate" edges, a single muted
                 phase-blue accent family, glow reserved strictly for interactive/live
                 elements (never static chrome or the header title). -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#0A0D12" />
            <SolidColorBrush x:Key="PanelBrush" Color="#B8141B24" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#8C4C5F73" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2F97D6" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#8AD2FF" />
            <SolidColorBrush x:Key="AccentHairlineBrush" Color="#402F97D6" />
            <SolidColorBrush x:Key="TextBrush" Color="#E8EDF2" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8CA0B3" />
            <SolidColorBrush x:Key="OkBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="WarnBrush" Color="#E8A93A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#E5484D" />

            <LinearGradientBrush x:Key="FallbackBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090C10" Offset="0" />
                <GradientStop Color="#12161C" Offset="0.5" />
                <GradientStop Color="#080A0D" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DarkenOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#B80A0D14" Offset="0" />
                <GradientStop Color="#F00A0D12" Offset="1" />
            </LinearGradientBrush>

            <BlurEffect x:Key="BackgroundBlurEffect" Radius="24" RenderingBias="Performance" />

            <DropShadowEffect x:Key="AccentGlowEffect" Color="#8AD2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.5" />
            <DropShadowEffect x:Key="OkGlowEffect" Color="#4CAF50" BlurRadius="10" ShadowDepth="0" Opacity="0.7" />
            <DropShadowEffect x:Key="WarnGlowEffect" Color="#E8A93A" BlurRadius="10" ShadowDepth="0" Opacity="0.7" />

            <!-- Hard, planar "milled steel plate" chrome: 2px corners, thin steel border,
                 no shadow/blur on static panels - blur/glow is reserved for the layers below. -->
            <Style x:Key="GlassPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#081014" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GhostChrome" Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1.5" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GhostChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="#33FFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
