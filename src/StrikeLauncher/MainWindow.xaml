<Window x:Class="StrikeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StrikeLauncher.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Strike Launcher - Age of Clones"
        Icon="Assets/app.ico"
        Height="680" Width="960"
        MinHeight="560" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:ModStatusToBrushConverter x:Key="StatusToBrush" />
        <conv:NullableBoolToStatusBrushConverter x:Key="ServerStatusToBrush" />

        <Style x:Key="ModListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar (replaces the native OS chrome so it matches the app theme) -->
            <Grid Grid.Row="0" Background="#0D1014">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/app.ico" Width="16" Height="16" />
                    <TextBlock Text="STRIKE LAUNCHER" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="─" Click="OnMinimizeClick" Style="{StaticResource TitleBarButtonStyle}" />
                    <Button Content="☐" Click="OnMaximizeRestoreClick" Style="{StaticResource TitleBarButtonStyle}" />
                    <Button Content="✕" Click="OnCloseClick" Style="{StaticResource TitleBarCloseButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- Layer 0: full-bleed background - blurred community artwork, darkened for contrast -->
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{StaticResource FallbackBackgroundBrush}" />
                    <Image Source="{Binding BackgroundImageSource}" Stretch="UniformToFill" Effect="{StaticResource BackgroundBlurEffect}" />
                    <Rectangle Fill="{StaticResource DarkenOverlayBrush}" />
                </Grid>

                <!-- Layer 1: content -->
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hero header: badge centered, HUD corner bracket bottom-right, settings pinned top-right -->
                    <Grid Grid.Row="0" Margin="0,4,0,20">
                        <Border Width="16" Height="16" BorderThickness="0,0,2,2" BorderBrush="{StaticResource PanelBorderBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.7" />

                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="3" Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                                    <Image Source="{Binding SteamAvatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="{Binding SteamUserName, TargetNullValue='Nicht verbunden'}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <Border Style="{StaticResource GlassPanelStyle}" Padding="10,8" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="SERVER STATUS" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding Arma3ServerOnline, Converter={StaticResource ServerStatusToBrush}}" />
                                        <TextBlock Text="Arma" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding TeamSpeakServerOnline, Converter={StaticResource ServerStatusToBrush}}" />
                                        <TextBlock Text="Teamspeak" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image Width="104" Height="104" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <BitmapImage UriSource="Assets/logo.png" DecodePixelWidth="416" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="A G E   O F   C L O N E S" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <Border Width="220" Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,6,0,6" HorizontalAlignment="Center" />
                            <TextBlock Text="104TH STRIKE PLATOON" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Button Content="⚙ Einstellungen" Click="OnOpenSettingsClick" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </Grid>

                    <!-- Body -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Mod list -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="12">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource AccentHairlineBrush}" Margin="0,0,0,8" />
                                <TextBlock DockPanel.Dock="Top" Text="MODS" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                                <ListBox ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource ModListBoxItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,0,10,0"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="2" CornerRadius="2" Padding="8,2" Margin="10,0,4,0"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Subtle}">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Log -->
                        <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}" Padding="12">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource AccentHairlineBrush}" Margin="0,0,0,8" />
                                <TextBlock DockPanel.Dock="Top" Text="VERLAUF" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                                <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" TextChanged="OnLogTextChanged"
                                         IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,4,12,0"
                                         Visibility="{Binding IsBusy, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Download-Seite" Command="{Binding OpenDownloadPageCommand}" Style="{StaticResource GhostButtonStyle}"
                                    Visibility="{Binding HasDownloadUrl, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" Margin="0,0,8,0" />
                            <Button Content="Mods prüfen" Command="{Binding CheckAndSubscribeModsCommand}" Style="{StaticResource GhostButtonStyle}"
                                    IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" Margin="0,0,8,0" />
                            <Button Content="{Binding StartButtonLabel}" Command="{Binding PrepareAndLaunchCommand}"
                                    IsEnabled="{Binding CanLaunch}"
                                    Effect="{StaticResource AccentGlowEffect}" FontSize="16" Padding="30,10" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
