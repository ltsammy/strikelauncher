<Window x:Class="StrikeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StrikeLauncher.Converters"
        Title="Strike Launcher - Age of Clones"
        Icon="Assets/app.ico"
        Height="680" Width="960"
        MinHeight="560" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:ModStatusToBrushConverter x:Key="StatusToBrush" />
        <conv:BoolToStatusBrushConverter x:Key="ReadyToBrush" />
        <conv:BoolToGlowEffectConverter x:Key="ReadyToGlow" />
    </Window.Resources>

    <Grid>
        <!-- Layer 0: full-bleed background - blurred community artwork, darkened for contrast -->
        <Grid ClipToBounds="True">
            <Rectangle Fill="{StaticResource FallbackBackgroundBrush}" />
            <Image Source="{Binding BackgroundImageSource}" Stretch="UniformToFill" Effect="{StaticResource BackgroundBlurEffect}" />
            <Rectangle Fill="{StaticResource DarkenOverlayBrush}" />
        </Grid>

        <!-- Layer 1: content -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero header: badge centered, HUD corner brackets, settings pinned top-right -->
            <Grid Grid.Row="0" Margin="0,4,0,20">
                <Border Width="16" Height="16" BorderThickness="2,2,0,0" BorderBrush="{StaticResource PanelBorderBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.7" />
                <Border Width="16" Height="16" BorderThickness="0,0,2,2" BorderBrush="{StaticResource PanelBorderBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.7" />

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="104" Height="104" Stretch="Uniform" />
                    <TextBlock Text="A G E   O F   C L O N E S" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <Border Width="220" Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,6,0,6" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{Binding IsReady, Converter={StaticResource ReadyToBrush}}"
                                 Effect="{Binding IsReady, Converter={StaticResource ReadyToGlow}}" />
                        <TextBlock Text="104TH BATTALION · STRIKE PLATOON LAUNCHER" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Button Content="⚙ Einstellungen" Click="OnOpenSettingsClick" Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Mod list -->
                <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Padding="12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource AccentHairlineBrush}" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Top" Text="MODS" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                        <ListView ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="380" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Status" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Log -->
                <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}" Padding="12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource AccentHairlineBrush}" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Top" Text="VERLAUF" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                        <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,4,12,0"
                                 Visibility="{Binding IsBusy, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Download-Seite" Command="{Binding OpenDownloadPageCommand}" Style="{StaticResource GhostButtonStyle}"
                            Visibility="{Binding HasDownloadUrl, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" Margin="0,0,8,0" />
                    <Button Content="Mods prüfen" Command="{Binding CheckModsCommand}" Style="{StaticResource GhostButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" Margin="0,0,8,0" />
                    <Button Content="START" Command="{Binding PrepareAndLaunchCommand}"
                            IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                            Effect="{StaticResource AccentGlowEffect}" FontSize="16" Padding="30,10" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
